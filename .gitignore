# anime_tools stage reports (report_dir defaults anchor on ANIMA_HOME = this
# checkout). Anchored: a bare `workspace/` also swallowed the
# library/curation_compat/workspace/ package, which is tracked source.
/workspace/
# anime_tools panel settings (seeded by the WebUI's anime_tools panel)
.anime_tools_gui.json

# Path rules for a subdirectory go in a .gitignore inside it, not here: ripgrep
# (Grep / Glob / Explore) applies this root file's path-anchored rules only when
# a search starts at the repo root, so ignored files there leak into any search
# started below it. Nested: configs/gui-methods, bench/cjk_{adapter,distill},
# project/finished/{sr,cjk_aware_anima,cjk_aware_anima_dit,…/datasets}.

# Font binaries (CJK lines fetch their own; on main their per-dir ignores are absent).
# The WebUI ships its own web fonts.
*.ttf
*.otf
*.ttc

# ocr_reader gate images (labels stay tracked in project/finished/ocr_reader/assets/)
project/finished/ocr_reader/eval_data/

# Cross-process curation settings lock (runtime only).
.anime_tools_webui.lock

# Snow session runtime state (logs / screenshots / nested worktree). The audit
# notes under .snow/plan/ stay trackable.
.snow/logs/
.snow/artifacts/
.snow/team-worktree/
